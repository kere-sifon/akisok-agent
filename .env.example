AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=akisok
SEARCH_API_KEY=tvly-your-tavily-key
MAX_SEARCH_CALLS_PER_RUN=10
RELEVANCE_THRESHOLD=0.6
REPRODUCTION_OVERLAP_THRESHOLD=0.15
DEDUP_SIMILARITY_THRESHOLD=0.92
DEDUP_LOOKBACK_DAYS=14
ADMIN_UI_PORT=8001
ADMIN_UI_HOST=127.0.0.1
CONTENT_REPO_PATH=/Users/you/dev/akisok-site
# In cluster: CONTENT_REPO_PATH=/content/akisok-site and ADMIN_UI_HOST=0.0.0.0
# Fine-grained PAT with Contents write on kere-sifon/akisok-site (deploy keys are disabled).
# GIT_TOKEN=
# Homelab is not EKS — put AWS keys in the agent Secret, not IRSA.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
SEED_LGA_ROTATION_SIZE=3
# Optional JSON object merging over src/ops/pricing.py defaults, e.g.
# {"us.anthropic.claude-haiku-4-5-20251001-v1:0": {"input": 0.0008, "output": 0.004}}
PRICING_OVERRIDE_JSON=
# Stable Image Core on Bedrock (us-west-2 — not the same region as other Bedrock calls)
IMAGE_MODEL_ID=stability.stable-image-core-v1:1
IMAGE_MODEL_REGION=us-west-2
# Upload API credentials (this repo writes images; the site only looks them up)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
